IDI_ICON1 ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/resources/icon.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SnippetManager"
            VALUE "FileDescription", "Snippet Manager - Text & Code Snippets"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "snippetmanager"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "snippetmanager.exe"
            VALUE "ProductName", "Snippet Manager"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END